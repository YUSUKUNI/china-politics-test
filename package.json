{
  "name": "china-politics-test",
  "version": "1.7.0",
  "private": true,
  "description": "China political stance test with anonymous result collection",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev:worker": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "deploy:pages": "wrangler pages deploy --cwd cloudflare-pages --branch main --commit-dirty=true",
    "db:migrate:local": "wrangler d1 migrations apply china-politics-test-results --local",
    "db:migrate:remote": "wrangler d1 migrations apply china-politics-test-results --remote",
    "check": "node --check index.js && node --check shared/results.js && node --check worker/index.mjs && node --check admin.js",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.12",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
