{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "china-politics-test-api",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://yusukuni.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "china-politics-test-results",
      "database_id": "8f61d50c-4181-464b-b6cf-67c61be0e525",
      "migrations_dir": "worker/migrations"
    }
  ]
}
